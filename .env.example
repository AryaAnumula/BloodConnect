# PLACEHOLDERS ONLY. Prefer: python scripts/bootstrap_env.py
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=0
DB_ENGINE=postgresql
POSTGRES_DB=bloodconnect
POSTGRES_USER=bloodconnect
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_VALUE
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
NOTIFICATION_BASE_URL=http://localhost:3000
NOTIFICATION_INTERNAL_TOKEN=CHANGE_ME_GENERATE_A_RANDOM_VALUE
DEMO_USER_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_VALUE
# Demo password is local-only; never send .env to teammates or commit it.
